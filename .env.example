PORT=3000

# Chave da API do Google Gemini (Google AI Studio). Sem ela, o jogo usa as dicas locais.
GEMINI_API_KEY=

# Modelo principal e modelo reserva (usado quando o principal responde 503 ou estoura o tempo).
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Nivel de raciocinio do Gemini 3: low | medium | high (vazio omite o campo).
GEMINI_THINKING_LEVEL=low

# Tempo maximo por tentativa e tempo total somando as tentativas.
GEMINI_TIMEOUT_MS=25000
GEMINI_BUDGET_MS=60000

# Limite de chamadas de IA por minuto por IP (dicas + chat + revisao de schema).
GEMINI_MAX_HINTS_PER_MINUTE=20

# Definir como 1 apenas atras de proxy reverso confiavel (nginx, Cloudflare, etc.)
TRUST_PROXY=0
